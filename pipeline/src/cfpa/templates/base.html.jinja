<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% if ga4_measurement_id %}
{% include "_ga4.html.jinja" +%}
{% endif %}
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
{% if noindex %}
<meta name="robots" content="noindex">
{% endif %}
{% if canonical_url %}
<link rel="canonical" href="{{ canonical_url }}">
{% endif %}
<link rel="stylesheet" href="{{ root }}assets/style.css">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
{% if canonical_url %}
<meta property="og:url" content="{{ canonical_url }}">
{% endif %}
<meta property="og:site_name" content="{{ site_name }}">
<meta name="twitter:card" content="summary">
</head>
<body>
<a class="skip-link" href="#main">Skip to main content</a>
<header class="site-header">
  <div class="wrap">
    <p class="site-name"><a href="{{ root }}">{{ site_name }}</a> <span class="site-tagline">California trout planting &amp; stocking schedule</span></p>
    <nav aria-label="Primary">
      <a href="{{ root }}">This week</a>
      <a href="{{ root }}about/">About &amp; privacy</a>
    </nav>
  </div>
</header>
<main id="main" class="wrap">
{% block content %}{% endblock %}
</main>
<footer class="site-footer">
  <div class="wrap">
    <p>{{ attribution_text }} {{ site_name }} is independent and is not affiliated with or endorsed by CDFW.</p>
    <p><a href="{{ attribution_url }}">{{ attribution_url }}</a> &middot; <a href="{{ root }}about/">about &amp; attribution</a> &middot; <a href="{{ root }}privacy/">privacy</a> &middot; <a href="{{ root }}support/">support</a></p>
    {% if ga4_measurement_id %}
    {# Hidden until the GA4 tag's script shows it: with no JavaScript there
       is no analytics to opt out of. See _ga4.html.jinja. #}
    <p id="analytics-choice" hidden><button type="button" id="analytics-opt-out" class="link-button" hidden>Opt out of analytics</button> <span id="analytics-status" role="status"></span></p>
    {% endif %}
  </div>
</footer>
</body>
</html>

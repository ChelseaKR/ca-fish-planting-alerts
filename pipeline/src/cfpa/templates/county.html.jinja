{% extends "base.html.jinja" %}
{% block content %}
<h1>{{ county }} County {{ species }} planting schedule</h1>
<p class="lede">
  {{ water_count }} {{ "water" if water_count == 1 else "waters" }} in {{ county }}
  County {{ "has" if water_count == 1 else "have" }} been on the California
  Department of Fish and Wildlife's {{ species }} planting schedule in the time
  this site has recorded{% if region_name %}. CDFW region: {% if region_link %}<a href="{{ root }}region/{{ region_link.slug }}/">{{ region_name }}</a>{% else %}{{ region_name }}{% endif %}{% endif %}.
  Each links to its own page with every scheduled week and a calendar feed.
</p>
<p class="muted">
  CDFW's schedule was last checked {{ source_fetched_label }}, when its current
  week was the {{ source_week_label }}. Plants are subject to change: every
  entry is scheduled, not confirmed.
</p>
{% if feed_path %}
<p class="muted">
  Subscribe: <a href="{{ root }}{{ feed_path }}">Atom feed of the {{ feed_scope }} schedule</a>
  for a feed reader. Each entry is scheduled, not confirmed.
</p>
{% endif %}

<h2>Scheduled this week</h2>
{% if this_week_rows %}
<table>
  <caption class="visually-hidden">{{ county }} County waters on CDFW's schedule for the {{ source_week_label }}</caption>
  <thead>
    <tr>
      <th scope="col">Water</th>
      <th scope="col">Species</th>
    </tr>
  </thead>
  <tbody>
    {% for row in this_week_rows %}
    <tr>
      <td><a href="{{ root }}water/{{ row.slug }}/">{{ row.name }}</a></td>
      <td>{{ row.species }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% else %}
<p>No {{ county }} County water is on CDFW's schedule for this week. That means no plant is scheduled here this week, not that there are no fish.</p>
{% endif %}

<h2>Scheduled for later weeks</h2>
{% if later_rows %}
<table>
  <caption class="visually-hidden">{{ county }} County waters on CDFW's schedule for a week after the {{ source_week_label }}</caption>
  <thead>
    <tr>
      <th scope="col">Week</th>
      <th scope="col">Water</th>
      <th scope="col">Species</th>
    </tr>
  </thead>
  <tbody>
    {% for row in later_rows %}
    <tr>
      <td>week of {{ row.week }}</td>
      <td><a href="{{ root }}water/{{ row.slug }}/">{{ row.name }}</a></td>
      <td>{{ row.species }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% else %}
<p>No later week is scheduled for a {{ county }} County water. That means nothing beyond the {{ source_week_label }} is on CDFW's schedule here right now, not that there are no fish.</p>
{% endif %}

<h2>Every {{ county }} County water on the schedule</h2>
<p>Newest at the top. Each water's latest week counts through this week. Later weeks are listed above.</p>
<table>
  <caption class="visually-hidden">Every {{ county }} County water CDFW has scheduled, with its latest scheduled week through the {{ source_week_label }}</caption>
  <thead>
    <tr>
      <th scope="col">Water</th>
      <th scope="col">Latest scheduled week, through this week</th>
      <th scope="col">Weeks on record</th>
    </tr>
  </thead>
  <tbody>
    {% for row in rows %}
    <tr>
      <td><a href="{{ root }}water/{{ row.slug }}/">{{ row.name }}</a></td>
      <td>{% if row.latest_start %}week of {{ row.latest_start }}{% else %}none through this week{% endif %}</td>
      <td>{{ row.weeks }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>

<p><a href="{{ root }}county/">Every county</a> &middot; <a href="{{ root }}">this week, statewide</a></p>
{% endblock %}

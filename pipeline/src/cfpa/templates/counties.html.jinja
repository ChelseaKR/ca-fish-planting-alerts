{% extends "base.html.jinja" %}
{% set share_card_kind = "county" %}
{% block content %}
<h1>California {{ species }} planting schedule by county</h1>
<p class="lede">
  The {{ county_count }} California counties with a water on the California
  Department of Fish and Wildlife's planting schedule in the time this site
  has recorded, grouped by CDFW region. CDFW was called the Department of
  Fish and Game (DFG) before 2013, and its schedule is still at a dfg.ca.gov
  address. Each county page shows what is
  scheduled this week and the latest scheduled week at every one of its
  waters.
</p>
{% if species_links %}
<p>By species: {% for l in species_links %}<a href="{{ root }}species/{{ l.slug }}/">{{ l.name }}</a>{% if not loop.last %} &middot; {% endif %}{% endfor %}.</p>
{% endif %}

{% if other_states %}
<p>
  Also on {{ site_name }}:
  {% for s in other_states %}<a href="{{ root }}{{ s.seg }}/">{{ s.name }} trout stocking schedule</a>{% if not loop.last %}, {% endif %}{% endfor %}.
</p>
{% endif %}

{% for region in regions %}
<section aria-labelledby="region-{{ region.code }}">
  <h2 id="region-{{ region.code }}">{{ region.name }}</h2>
  <p><a href="{{ root }}region/{{ region.slug }}/">This week and next in the {{ region.name }}</a></p>
  <ul class="water-index">
    {% for c in region.counties %}
    <li><a href="{{ root }}county/{{ c.slug }}/">{{ c.name }} County</a> <span class="muted">({{ c.count }} {{ "water" if c.count == 1 else "waters" }})</span></li>
    {% endfor %}
  </ul>
</section>
{% endfor %}
{% set gear_heading = "Gear for a California trout water" %}
{% set gear_intro = "Planning a trip to a water on CDFW's schedule?" %}
{% set gear_placement = "counties" %}
{% include "_gear_block.html.jinja" %}

{% if week_archive %}
<p>Looking for an earlier week? <a href="{{ root }}week/">Past weeks of CDFW's schedule</a>, most recent to oldest.</p>
{% endif %}
{% endblock %}

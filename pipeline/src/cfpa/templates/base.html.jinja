<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% if ga4_measurement_id %}
{% include "_ga4.html.jinja" +%}
{% endif %}
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
{% if app_store_live %}
{# Safari's Smart App Banner (site.py APP_STORE_LIVE). #}
<meta name="apple-itunes-app" content="app-id={{ app_store_id }}">
{% endif %}
{% if noindex %}
<meta name="robots" content="noindex">
{% endif %}
{% if canonical_url %}
<link rel="canonical" href="{{ canonical_url }}">
{% endif %}
{% if feed_path %}
{# Atom autodiscovery (feeds.py). A plain static file, no script. #}
<link rel="alternate" type="application/atom+xml" title="{{ feed_title }}" href="{{ root }}{{ feed_path }}">
{% endif %}
<link rel="stylesheet" href="{{ root }}assets/style.css">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
{% if canonical_url %}
<meta property="og:url" content="{{ canonical_url }}">
{% endif %}
<meta property="og:site_name" content="{{ site_name }}">
{# The page kind's share card (share_cards.py); a template names its kind with
   {% set share_card_kind = "..." %}, and a page that sets none gets the home card. #}
{% set card = share_cards[share_card_kind|default(share_card_default_kind)] %}
<meta property="og:image" content="{{ card.url }}">
<meta property="og:image:width" content="{{ card.width }}">
<meta property="og:image:height" content="{{ card.height }}">
<meta property="og:image:alt" content="{{ card.alt }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">
<meta name="twitter:image" content="{{ card.url }}">
<meta name="twitter:image:alt" content="{{ card.alt }}">
{% if google_site_verification %}
{# Search Console's URL-prefix ownership check (site.py
   GOOGLE_SITE_VERIFICATION, docs/SEARCH-CONSOLE.md). Home page only. #}
<meta name="google-site-verification" content="{{ google_site_verification }}">
{% endif %}
{% if structured_data %}
{# schema.org data for search engines (docs/adr/0013). Not JavaScript: the
   browser never runs it and it fetches nothing. tojson escapes <, > and &,
   so no water name can close this element. #}
<script type="application/ld+json">{{ structured_data|tojson }}</script>
{% endif %}
</head>
<body>
<a class="skip-link" href="#main">Skip to main content</a>
<header class="site-header">
  <div class="wrap">
    <p class="site-name"><a href="{{ root }}">{{ site_name }}</a> <span class="site-tagline">{% if header_tagline %}{{ header_tagline }}{% else %}California trout planting &amp; stocking schedule{% endif %}</span></p>
    <nav aria-label="Primary">
      {% if nav_links %}
      {% for label, href in nav_links %}
      <a href="{{ href }}">{{ label }}</a>
      {% endfor %}
      {% else %}
      <a href="{{ root }}">This week</a>
      <a href="{{ root }}county/">By county</a>
      {% if states_nav %}
      <a href="{{ root }}states/">Other states</a>
      {% endif %}
      <a href="{{ root }}about/">About &amp; privacy</a>
      {% endif %}
    </nav>
  </div>
</header>
<main id="main" class="wrap">
{% if breadcrumb %}
{# Mirrors the BreadcrumbList in the structured data, name for name. #}
<nav aria-label="Breadcrumb" class="breadcrumb">
  <ol>
    {% for name, url in breadcrumb %}
    {% if loop.last %}
    <li><a href="{{ url }}" aria-current="page">{{ name }}</a></li>
    {% else %}
    <li><a href="{{ url }}">{{ name }}</a></li>
    {% endif %}
    {% endfor %}
  </ol>
</nav>
{% endif %}
{% block content %}{% endblock %}
</main>
<footer class="site-footer">
  <div class="wrap">
    {% if footer_disclaimer %}
    <p>{{ attribution_text }} {{ footer_disclaimer }}</p>
    {% else %}
    <p>{{ attribution_text }} {{ site_name }} is independent and is not affiliated with or endorsed by CDFW.</p>
    {% endif %}
    <p><a href="{{ attribution_url }}">{{ attribution_url }}</a> &middot; <a href="{{ root }}about/">about &amp; attribution</a> &middot; <a href="{{ root }}gear/">what to bring</a> &middot; {% if open_data %}<a href="{{ root }}data/">open data</a> &middot; {% endif %}<a href="{{ root }}privacy/">privacy</a> &middot; <a href="{{ root }}support/">support</a> &middot; <a href="{{ root }}guide/">guides</a></p>
    {% if ga4_measurement_id %}
    {# Hidden until the GA4 tag's script shows it: with no JavaScript there
       is no analytics to opt out of. See _ga4.html.jinja. #}
    <p id="analytics-choice" hidden><button type="button" id="analytics-opt-out" class="link-button" hidden>Opt out of analytics</button> <span id="analytics-status" role="status"></span></p>
    {% endif %}
  </div>
</footer>
</body>
</html>

{% extends "base.html.jinja" %}
{% block head_extra %}{% if map_summary and map_summary.placed %}<script type="module" src="{{ root }}map/map.js"></script>{% endif %}{% endblock %}
{% block content %}
<h1>This week's California trout planting schedule: {{ source_week_label }}</h1>
<p class="lede">
  California Department of Fish and Wildlife scheduled these waters for
  planting the {{ source_week_label }}. Plants are <strong>subject to
  change</strong> by CDFW &mdash; treat every entry as scheduled, not
  confirmed. Data refreshed {{ generated_at_label }}.
</p>
{% if app_store_live %}
{% with badge_placement = "home" %}{% include "_app_store_badge.html.jinja" %}{% endwith %}
{% endif %}

{% if map_summary and map_summary.placed %}
<section class="map-section" aria-labelledby="map-heading" data-map="home" data-root="{{ root }}">
  <h2 id="map-heading">Map</h2>
  <p>
    {% for st in map_summary.states %}{{ st.name }}: {{ st.placed }} of {{ st.total }} waters have a map location{% if not st.placed %} (none yet: no location source for this state){% endif %}{% if not loop.last %}; {% else %}.{% endif %}
    {% endfor %}{% if map_summary.this_week %}This week, {{ map_summary.this_week_placed }} of the {{ map_summary.this_week }} scheduled or stocked waters are on the map. {% endif %}A water is placed only when federal map data names exactly one water like it in its county, so the tables below list every water, mapped or not.
  </p>
  <ul class="map-legend">
    <li class="this-week">Scheduled this week</li>
    <li class="other">Other waters</li>
    <li class="approx">Stream: approximate point</li>
  </ul>
  <p><button type="button" data-map-show hidden>Show map</button> <span data-map-status role="status"></span></p>
  <div data-map-canvas role="region" aria-label="Map of waters with a location; every water is also in the tables below" hidden></div>
  <noscript><p>The map needs JavaScript. Every water is in the tables below.</p></noscript>
</section>
{% endif %}

{% if regions %}
{% for region in regions %}
<section aria-labelledby="region-{{ region.code }}">
  <h2 id="region-{{ region.code }}">{{ region.name }}</h2>
  <table>
    <caption class="visually-hidden">Waters scheduled for planting in {{ region.name }} for the {{ source_week_label }}</caption>
    <thead>
      <tr>
        <th scope="col">Water</th>
        <th scope="col">County</th>
        <th scope="col">Species</th>
      </tr>
    </thead>
    <tbody>
      {% for row in region.rows %}
      <tr>
        <td><a href="{{ root }}water/{{ row.slug }}/">{{ row.name }}</a></td>
        <td>{% for c in row.county_links %}<a href="{{ root }}county/{{ c.slug }}/">{{ c.name }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</td>
        <td>{{ row.species }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</section>
{% endfor %}
{% else %}
<p>No plants are listed for the {{ source_week_label }} on CDFW's schedule. This is CDFW's own page saying so &mdash; not a failed or stale fetch, which this site refuses to publish (see <a href="{{ root }}about/">about &amp; attribution</a>).</p>
{% endif %}

<h2>Browse by county</h2>
<p>Each county page shows this week's plants there and the latest scheduled week at every water. <a href="{{ root }}county/">Every county, by CDFW region</a>.</p>
<ul class="water-index">
  {% for c in county_counts %}
  <li><a href="{{ root }}county/{{ c.slug }}/">{{ c.name }} County</a> <span class="muted">({{ c.count }} {{ "water" if c.count == 1 else "waters" }})</span></li>
  {% endfor %}
</ul>

<h2>Browse by water</h2>
{% if app_store_url %}
<p><a href="{{ app_store_url }}">Get the iOS app</a> for local notifications when a favorite water appears in the new week &mdash; no account, no server, alerts happen on your device.</p>
{% else %}
<p>An iOS app with local notifications when a favorite water appears in the new week is on its way &mdash; no account, no server, alerts happen on your device. <a href="{{ root }}about/#app">How the app will work</a>.</p>
{% endif %}
<ul class="water-index">
  {% for w in all_waters %}
  <li><a href="{{ root }}water/{{ w.slug }}/">{{ w.name }}</a> <span class="muted">({{ w.county }})</span></li>
  {% endfor %}
</ul>
{% endblock %}

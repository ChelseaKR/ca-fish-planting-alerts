{% extends "base.html.jinja" %}
{% set share_card_kind = "water" %}
{% block content %}
{% if answer and answer.name_first %}
<h1>{{ answer.shown_name }} ({{ water.name }} on CDFW's schedule) {{ water.species }} stocking schedule</h1>
{% else %}
<h1>{{ water.search_place }} {{ water.species }} stocking schedule and history</h1>
{% endif %}
{# Answer first (DECISIONS 0046): only the pages in answer_first say this
   here. Every week is a recorded CDFW week, nothing is forecast. #}
{% if answer and (answer.lede or answer.season) %}
<p>
  {% if answer.lede %}
  {% if answer.lede.kind == "this_week" %}
  CDFW has {{ answer.shown_name }} on its {{ water.species }} planting schedule this week, the week of {{ answer.lede.week }}.
  {% elif answer.lede.kind == "next" %}
  CDFW has scheduled {{ answer.shown_name }} for a {{ water.species }} plant the week of {{ answer.lede.week }}.
  {% else %}
  CDFW last scheduled {{ answer.shown_name }} for a {{ water.species }} plant the week of {{ answer.lede.week }}.
  {% endif %}
  {% endif %}
  {% if answer.season %}
  {% if answer.season.weeks %}
  Last {{ answer.season.season }} ({{ answer.season.label }}) it was on the schedule the {{ "week" if answer.season.weeks|length == 1 else "weeks" }} of {% for d in answer.season.weeks %}{{ d }}{% if not loop.last %}{{ " and " if loop.revindex == 2 else ", " }}{% endif %}{% endfor %}.
  {% else %}
  Last {{ answer.season.season }} ({{ answer.season.label }}) it was not on CDFW's schedule in any week.
  {% endif %}
  {% endif %}
</p>
{% endif %}
{% include "_water_status.html.jinja" %}
<p class="lede">
  {{ water.name }} is in {{ water.county_phrase }}, in the California
  Department of Fish and Wildlife's {{ water.region_name }}.{% if water.usgs_name %} The U.S. Geological Survey names it {{ water.usgs_name }}.{% endif %} It has been on
  CDFW's {{ water.species }} planting schedule in
  {{ water.listed_week_count }} {{ "week" if water.listed_week_count == 1 else "weeks" }}
  {% if recorded_since_label %}since the {{ recorded_since_label }}, as far back as this site's record goes{% else %}in the time this site has recorded{% endif %}.
  {% if water.this_week %}
  It is scheduled for planting this week, the {{ source_week_label }}.
  {% elif water.last_listed_label %}
  It was last scheduled for planting the {{ water.last_listed_label }}.
  {% endif %}
  {% if water.next_listed_label %}
  Next scheduled: the {{ water.next_listed_label }}.
  {% endif %}
</p>
{% if water.nothing_current %}
<p>
  <strong>Nothing is on CDFW's schedule for {{ water.name }} this week or later.</strong>
  That means no plant is scheduled right now, not that there are no fish.
</p>
{% for c in scheduled_elsewhere %}
<section aria-labelledby="now-{{ c.slug }}">
  <h2 id="now-{{ c.slug }}">On CDFW's schedule now in {{ c.name }} County</h2>
  {% if c.waters %}
  <ul class="water-index">
    {% for s in c.waters %}
    <li><a href="{{ root }}water/{{ s.slug }}/">{{ s.name }}</a>, {{ s.when }}</li>
    {% endfor %}
  </ul>
  {% else %}
  <p>No other {{ c.name }} County water is on CDFW's schedule this week or later.</p>
  {% endif %}
  <p><a href="{{ root }}county/{{ c.slug }}/">{{ c.name }} County planting schedule</a></p>
</section>
{% endfor %}
{% endif %}
<p class="muted">
  CDFW's schedule was last checked {{ source_fetched_label }}, when its current
  week was the {{ source_week_label }}. Plants are subject to change: every
  entry is scheduled, not confirmed.
</p>

<p>
  <a href="feed.ics" data-ga-event="calendar_subscribe_click" data-ga-placement="water" data-ga-type="ics">Subscribe to {{ water.name }}'s planting calendar (.ics)</a>
  {% if app_store_url %}
  &middot; <a href="{{ app_store_url }}" data-app-store-placement="water" data-app-store-kind="link">get the iOS app</a> for a notification when {{ water.name }} appears in a new week.
  {% else %}
  &middot; an iOS app with a notification when {{ water.name }} appears in a new week is on its way (<a href="{{ root }}about/#app">how it will work</a>).
  {% endif %}
</p>

<h2>Planting history</h2>
{% if water.plants %}
<table{% if water.has_removed_weeks %} aria-describedby="status-note"{% endif %}>
  <caption class="visually-hidden">Every week CDFW has scheduled a plant at {{ water.name }}, most recent first</caption>
  <thead>
    <tr>
      <th scope="col">Week</th>
      <th scope="col">Species</th>
      <th scope="col">Status</th>
    </tr>
  </thead>
  <tbody>
    {% for p in water.plants %}
    <tr>
      <td>{% if p.week_page %}<a href="{{ root }}week/{{ p.start }}/">{{ p.label }}</a>{% else %}{{ p.label }}{% endif %}</td>
      <td>{{ p.species }}</td>
      <td>{{ "Scheduled" if p.status == "listed" else "Schedule changed" }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% if water.has_removed_weeks %}
<p class="muted" id="status-note">
  "Schedule changed" means CDFW listed this week earlier and later removed it
  from its schedule. CDFW's plans can change.
</p>
{% endif %}
{% else %}
<p>No plants observed yet for {{ water.name }}.</p>
{% endif %}

{% include "_water_record.html.jinja" %}
{% include "_water_months.html.jinja" %}

<h2>About this water</h2>
<dl>
  <dt>{{ "County" if water.county_links|length == 1 else "Counties" }}</dt>
  <dd>{% for c in water.county_links %}<a href="{{ root }}county/{{ c.slug }}/">{{ c.name }} County</a>{% if not loop.last %}, {% endif %}{% endfor %}</dd>
  <dt>CDFW region</dt><dd>{{ water.region_name }}</dd>
  <dt>CDFW water map</dt><dd><a href="{{ water.cdfw_map_url }}">View {{ water.name }} on CDFW's map</a></dd>
  {% if water_map %}
  <dt>Map</dt><dd><a href="{{ water_map.url }}" rel="noopener noreferrer">View on map</a> (opens OpenStreetMap)</dd>
  <dt>Coordinates</dt><dd>{{ water_map.lat }}, {{ water_map.lon }}{% if water_map.approximate %}, approximate: a point on the stream, which CDFW plants along its length{% else %}, a point inside the water{% endif %}. Source: U.S. Geological Survey.</dd>
  {% endif %}
  {% if water.other_names %}<dt>Also listed by CDFW as</dt><dd>{{ water.other_names }}</dd>{% endif %}
</dl>

{% if gear_links %}
{% set gear_heading = "Gear for this water" %}
{% set gear_intro = "Planning a trip to " ~ water.name ~ "?" %}
{% set gear_placement = "water" %}
{% include "_gear_block.html.jinja" %}
{% endif %}


{% for c in other_waters_by_county %}
<section aria-labelledby="others-{{ c.slug }}">
  <h2 id="others-{{ c.slug }}">Other {{ c.name }} County waters on the schedule</h2>
  {% if c.waters %}
  <ul class="water-index">
    {% for s in c.waters %}
    <li><a href="{{ root }}water/{{ s.slug }}/">{{ s.name }}</a></li>
    {% endfor %}
  </ul>
  <p><a href="{{ root }}county/{{ c.slug }}/">{{ c.name }} County: this week's plants and the latest scheduled week at every water</a></p>
  {% else %}
  <p>No other {{ c.name }} County water has been on CDFW's schedule in the time this site has recorded. <a href="{{ root }}county/{{ c.slug }}/">{{ c.name }} County planting schedule</a>.</p>
  {% endif %}
</section>
{% endfor %}
{% if answer and answer.near_list %}
{# In place of the region list (DECISIONS 0046): waters on this week's
   schedule, nearest first when both points are known. #}
{% set near = answer.near_list %}
<section aria-labelledby="near-heading">
  <h2 id="near-heading">{% if near.basis == "distance" %}Nearest waters on CDFW's schedule this week{% else %}On CDFW's schedule this week in {{ near.where }}{% endif %}</h2>
  <ul class="water-index">
    {% for s in near.waters %}
    <li><a href="{{ root }}water/{{ s.slug }}/">{{ s.name }}</a> <span class="muted">({{ s.county }}{% if s.miles %}, about {{ s.miles }} miles{% endif %})</span></li>
    {% endfor %}
  </ul>
  <p>{% include "_near_note.html.jinja" %}</p>
  <p><a href="{{ root }}">Every water on this week's schedule</a></p>
</section>
{% elif region_related %}
<section aria-labelledby="region-related-heading">
  <h2 id="region-related-heading">More waters in CDFW's {{ region_name }}</h2>
  <ul class="water-index">
    {% for s in region_related %}
    <li><a href="{{ root }}water/{{ s.slug }}/">{{ s.name }}</a></li>
    {% endfor %}
  </ul>
</section>
{% endif %}
{% endblock %}

{% extends "base.html.jinja" %}
{% set share_card_kind = "state" %}
{% block content %}
{# DECISIONS 0051: the H1 and title are site_states.STATES_INDEX_HEADING;
   test_states_copy_guard keeps coverage claims out of both. #}
<h1>{{ heading }}</h1>
<p class="lede">
  {{ site_name }} carries {{ live_names }} from each state's own wildlife
  agency. For the other states and the District of Columbia, the list below
  says where each one stands and links to that agency's own page:
  {{ site_name }} does not copy or summarize those states' data.
</p>

<h2>States on {{ site_name }}</h2>
<p>
  Some agencies publish a schedule of planned stockings; others report
  stockings after they happen; New York publishes a spring plan once a year
  in its own words. Each page says which, and shows every date at the
  precision the agency gives it: a day, a week, a month, or the agency's own
  words, such as "April - third week".
</p>
{# On a phone the five columns stack into one block per state, each value
   labeled, so a state name never breaks mid-word (style.css .stack-table).
   The explicit roles keep it a table for screen readers when the CSS
   changes its display; the visible labels are hidden from them, because
   each cell already has its column header. #}
<table class="stack-table" role="table">
  <caption class="visually-hidden">States {{ site_name }} carries, with each agency and when its data was last checked</caption>
  <thead role="rowgroup">
    <tr role="row">
      <th scope="col" role="columnheader">State</th>
      <th scope="col" role="columnheader">Agency</th>
      <th scope="col" role="columnheader">What it publishes</th>
      <th scope="col" role="columnheader">Waters</th>
      <th scope="col" role="columnheader">Last checked</th>
    </tr>
  </thead>
  <tbody role="rowgroup">
    {% for r in rows %}
    <tr role="row">
      <td role="cell" data-label="State"><a href="{{ r.href }}">{{ r.name }}</a></td>
      <td role="cell" data-label="Agency">{{ r.agency }}</td>
      <td role="cell" data-label="What it publishes">{{ r.kind }}</td>
      <td role="cell" data-label="Waters">{{ r.waters }}</td>
      <td role="cell" data-label="Last checked">{% if r.paused_since %}Updates paused since {{ r.paused_since }}{% else %}{{ r.checked }}{% endif %}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
<p>
  Browsing and every water's history are free on this site and in the app.
  In the iOS app, alerts and the widget are a one-time purchase for each
  state. <a href="{{ root }}about/">About &amp; attribution</a>.
</p>

{# The design system's StateCoverageList (cfpa.state_coverage, DECISIONS
   0051): the 50 states and DC, alphabetical, each status in words and from
   data. A state that is not carried gets one sentence and one link to its
   agency's own page, and nothing else. #}
<h2 id="every-state">Where each state stands</h2>
{% set shown = coverage|map(attribute="status")|list %}
<p>
  &ldquo;Live on {{ site_name }}&rdquo; links to that state's pages here.
  {% if "paused" in shown %}&ldquo;Updates paused&rdquo; means the agency's
  page could not be read lately; the pages stay up with the last good read
  and its date.
  {% endif %}{% if "asking" in shown %}&ldquo;Asking the agency&rdquo; means a
  request to use its data was sent on that date; nothing is promised.
  {% endif %}{% if "terms" in shown %}&ldquo;Not planned&rdquo; means the
  agency's terms don't allow reuse.
  {% endif %}For the rest, the agency's own stocking
  page is the official source, which {{ site_name }} does not copy. Agency
  links were checked {{ coverage_checked }}; agencies move pages, so if one is
  out of date, the agency's home page has it.
</p>
<ul class="tt-states" aria-label="Trout stocking coverage by state">
  {% for s in coverage %}
  <li class="tt-state{% if s.status in ('live', 'paused') %} tt-state--live{% endif %}" id="{{ s.id }}">
    <h3>{{ s.name }}</h3>
    {% if s.status == "live" %}
    <p><span class="tt-badge tt-badge--now">Live on {{ site_name }}</span> <a href="{{ s.href }}">Open {{ s.name }}'s schedule</a></p>
    {% elif s.status == "paused" %}
    <p><span class="tt-badge tt-badge--next">Updates paused since {{ s.since_label }}</span> <a href="{{ s.href }}">Open {{ s.name }}'s schedule</a></p>
    {% else %}
    {% if s.status == "asking" %}
    <p><span class="tt-badge tt-badge--next">Asking the agency, since {{ s.since_label }}</span></p>
    {% elif s.status == "terms" %}
    <p><span class="tt-badge tt-badge--none">Not planned</span> The agency&rsquo;s terms don&rsquo;t allow reuse.</p>
    {% else %}
    <p><span class="tt-badge tt-badge--none">Not covered</span> {{ site_name }} doesn&rsquo;t carry {{ s.name }}.</p>
    {% endif %}
    {% if s.homepage_only %}
    <p><a href="{{ s.url }}" rel="noopener">See {{ s.short }}'s website<span class="visually-hidden">: {{ s.agency }}</span></a></p>
    <p class="muted">No stocking page could be confirmed, so this links to the agency's own site.</p>
    {% else %}
    <p><a href="{{ s.url }}" rel="noopener">{{ s.short }}&rsquo;s own stocking page is the official source<span class="visually-hidden">: {{ s.agency }}, {{ s.name }}</span></a></p>
    {% endif %}
    {% endif %}
  </li>
  {% endfor %}
</ul>
{% endblock %}

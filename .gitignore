# pipeline: uv-managed venv, caches -- pipeline/uv.lock IS committed
pipeline/.venv/
pipeline/.pytest_cache/
pipeline/**/__pycache__/
pipeline/.coverage
# The unchanged-page log (cfpa.source_log) is a workflow artifact, never committed.
pipeline/data/source_log.json
pipeline/htmlcov/

# site/ is build output: generated by `cfpa` from schema+data every run,
# deployed straight to GitHub Pages by CI (pipeline/src/cfpa/cli.py creates
# the directory itself, so nothing needs to pre-exist here). Not committed --
# pipeline/data/ (history.json, aliases.json) is the real committed asset
# it's built from.
/site/

.DS_Store

# tools/site-checks: npm-installed checkers (package-lock.json IS committed)
tools/site-checks/node_modules/

# Pinned third-party scanners built by `make greenlight` (scripts/check_greenlight.py).
/build/

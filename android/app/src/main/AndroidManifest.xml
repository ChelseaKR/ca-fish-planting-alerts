<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The one network request: the snapshot GET. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+: asked only after the app's own explanation (the priming sheet). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Cloud backup is off and device-to-device transfer is on: favorites and
      the alert baseline stay on this person's devices and never go to a
      backup service (docs/DECISIONS.md 0022).
    -->
    <application
        android:name=".TroutTruckApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.TroutTruck"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- trouttruck://water/<id> and trouttruck://unlock: the widget's and the alerts' links. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="trouttruck" />
            </intent-filter>
        </activity>

        <!-- "Mute this water" on an alert. Not exported: only the app's own PendingIntent reaches it. -->
        <receiver
            android:name=".MuteReceiver"
            android:exported="false" />

        <receiver
            android:name=".widget.FavoriteWatersReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/favorite_waters_widget_info" />
        </receiver>
    </application>

    <!-- The Play Store page for the About row ("Rate Trout Truck"), Android 11+ package visibility. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>

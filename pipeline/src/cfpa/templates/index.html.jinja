{% extends "base.html.jinja" %}
{% block content %}
{% if week_is_empty %}
<h1>California trout planting schedule: nothing listed for the {{ source_week_label }}</h1>
<p class="lede">
  The California Department of Fish and Wildlife's schedule lists no plants
  for the current week, the {{ source_week_label }}. That means no plant is
  scheduled this week, not that there are no fish. Below are the waters it
  has scheduled for a later week and the waters it scheduled most recently,
  each with its own week. Plants are <strong>subject to change</strong> by
  CDFW &mdash; treat every entry as scheduled, not confirmed. Data refreshed
  {{ generated_at_label }}.
</p>
{% else %}
<h1>This week's California trout planting schedule: {{ source_week_label }}</h1>
<p class="lede">
  California Department of Fish and Wildlife scheduled these waters for
  planting the {{ source_week_label }}. Plants are <strong>subject to
  change</strong> by CDFW &mdash; treat every entry as scheduled, not
  confirmed. Data refreshed {{ generated_at_label }}.
</p>
{% endif %}
{% if other_states %}
<p>
  Also on {{ site_name }}:
  {% for s in other_states %}<a href="{{ root }}{{ s.seg }}/">{{ s.name }} trout stocking schedule</a>{% if not loop.last %}, {% endif %}{% endfor %}.
</p>
{% endif %}
{% if feed_path %}
<p class="muted">
  Subscribe: <a href="{{ root }}{{ feed_path }}">Atom feed of the {{ feed_scope }} schedule</a>
  for a feed reader. Each entry is scheduled, not confirmed.
</p>
{% endif %}
{% if app_store_live %}
{% with badge_placement = "home" %}{% include "_app_store_badge.html.jinja" %}{% endwith %}
{% endif %}

{% if closest_enabled and regions %}
{# "Closest to me": hidden here, shown by assets/closest.js only when the
   browser can do it. Without JavaScript the page is the lists below. #}
<section id="closest" class="closest" aria-labelledby="closest-heading" data-coords="{{ coords_path }}" hidden>
  <h2 id="closest-heading">Closest to me</h2>
  <p>
    Sort this week's waters by distance from you. Your browser asks for your
    location when you press the button, and the sorting happens in your
    browser: your location is not sent to this site or to anyone else, and it
    is not saved.
  </p>
  <p><button type="button" id="closest-button">Sort by closest to me</button></p>
  <p id="closest-status" role="status"></p>
  <div id="closest-result"></div>
</section>
{{ closest_script_tag|safe }}
{% endif %}

{% if regions %}
{% for region in regions %}
<section aria-labelledby="region-{{ region.code }}">
  <h2 id="region-{{ region.code }}">{{ region.name }}</h2>
  <table>
    <caption class="visually-hidden">Waters scheduled for planting in {{ region.name }} for the {{ source_week_label }}</caption>
    <thead>
      <tr>
        <th scope="col">Water</th>
        <th scope="col">County</th>
        <th scope="col">Species</th>
      </tr>
    </thead>
    <tbody>
      {% for row in region.rows %}
      <tr{% if closest_enabled %} data-slug="{{ row.slug }}"{% endif %}>
        <td><a href="{{ root }}water/{{ row.slug }}/">{{ row.name }}</a></td>
        <td>{% for c in row.county_links %}<a href="{{ root }}county/{{ c.slug }}/">{{ c.name }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</td>
        <td>{{ row.species }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</section>
{% endfor %}
{% else %}
<section aria-labelledby="next-scheduled">
  <h2 id="next-scheduled">Next scheduled</h2>
  {% if upcoming_rows %}
  {% with rows = upcoming_rows, caption = "Waters CDFW has scheduled for planting in a later week, in date order" %}{% include "_home_week_rows.html.jinja" %}{% endwith %}
  {% else %}
  <p>CDFW's schedule lists no plants for a later week yet. That means nothing is scheduled beyond the {{ source_week_label }} right now, not that there are no fish.</p>
  {% endif %}
</section>
{% if recent_rows %}
<section aria-labelledby="recently-scheduled">
  <h2 id="recently-scheduled">Most recently scheduled: the {{ recent_rows[0].week_label }}</h2>
  {% with rows = recent_rows, caption = "Waters CDFW scheduled for planting the " ~ recent_rows[0].week_label %}{% include "_home_week_rows.html.jinja" %}{% endwith %}
  <p class="muted">Every water's page has its full week-by-week history.</p>
</section>
{% endif %}
<p>No plants are listed for the {{ source_week_label }} on CDFW's schedule. This is CDFW's own page saying so &mdash; not a failed or stale fetch, which this site refuses to publish (see <a href="{{ root }}about/">about &amp; attribution</a>).</p>
{% endif %}

{% if region_links %}
<h2>Browse by CDFW region</h2>
<ul class="water-index">
  {% for r in region_links %}
  <li><a href="{{ root }}region/{{ r.slug }}/">{{ r.name }}</a> <span class="muted">({{ r.county_count }} {{ "county" if r.county_count == 1 else "counties" }})</span></li>
  {% endfor %}
</ul>
{% endif %}

{% if species_links %}
<h2>Browse by species</h2>
<ul class="water-index">
  {% for l in species_links %}
  <li><a href="{{ root }}species/{{ l.slug }}/">{{ l.name }}</a></li>
  {% endfor %}
</ul>
{% endif %}

<h2>Guides</h2>
<p>New to the schedule? <a href="{{ root }}guide/">Plain guides</a> explain <a href="{{ root }}guide/how-to-read-the-schedule/">how to read it</a>, <a href="{{ root }}guide/scheduled-vs-confirmed/">what scheduled means</a> and <a href="{{ root }}guide/what-is-a-trout-plant/">what a trout plant is</a>.</p>

<h2>Browse by county</h2>
<p>Each county page shows this week's plants there and the latest scheduled week at every water. <a href="{{ root }}county/">Every county, by CDFW region</a>.</p>
<ul class="water-index">
  {% for c in county_counts %}
  <li><a href="{{ root }}county/{{ c.slug }}/">{{ c.name }} County</a> <span class="muted">({{ c.count }} {{ "water" if c.count == 1 else "waters" }})</span></li>
  {% endfor %}
</ul>

<h2>Browse by water</h2>
{% if app_store_url %}
<p><a href="{{ app_store_url }}" data-app-store-placement="home" data-app-store-kind="link">Get the iOS app</a> for local notifications when a favorite water appears in the new week &mdash; no account, no server, alerts happen on your device.</p>
{% else %}
<p>An iOS app with local notifications when a favorite water appears in the new week is on its way &mdash; no account, no server, alerts happen on your device. <a href="{{ root }}about/#app">How the app will work</a>.</p>
{% endif %}
<ul class="water-index">
  {% for w in all_waters %}
  <li><a href="{{ root }}water/{{ w.slug }}/">{{ w.name }}</a> <span class="muted">({{ w.county }})</span></li>
  {% endfor %}
</ul>
{% endblock %}

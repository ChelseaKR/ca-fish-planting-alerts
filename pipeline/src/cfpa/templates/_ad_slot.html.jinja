{#
  The one display ad unit (cfpa/ads.py, docs/adr/0040). base.html.jinja
  includes this only when ad_slot() returns settings: ads are on and the
  page is one of ads.AD_PAGES.

  The <aside> starts collapsed (class ad-pending: zero height, out of the
  accessibility tree, label hidden) and opens only when AdSense marks the
  unit data-ad-status="filled". It is collapsed rather than display:none
  because AdSense sizes a responsive unit from its container's width.
  "unfilled", "unfill-optimized", a failed script or no answer within 10
  seconds removes it, so nobody sees an empty box.

  The AdSense script is added by script, after the guard: a browser that
  sends Global Privacy Control or Do Not Track, or a visitor who chose
  "Turn off ads" on the privacy page (a localStorage flag on this device),
  gets no request to Google for ads and no ad cookie. Otherwise the request
  asks for non-personalized ads only.
#}
<aside class="ad-slot ad-pending" id="ad-slot" aria-label="Advertisement" aria-hidden="true">
  <p class="ad-label muted" hidden>Advertisement &middot; <a href="{{ root }}privacy/#ads">about these ads</a></p>
  <ins class="adsbygoogle" data-ad-client="{{ ad.client }}" data-ad-slot="{{ ad.slot }}" data-ad-format="auto" data-full-width-responsive="true"></ins>
</aside>
<script>
(function () {
  var n = navigator, w = window, d = document;
  var box = d.getElementById("ad-slot");
  if (!box) return;
  var unit = box.querySelector("ins.adsbygoogle");
  var label = box.querySelector(".ad-label");
  var done = false;
  function drop() { done = true; if (box.parentNode) box.parentNode.removeChild(box); }
  var dnt = n.doNotTrack || w.doNotTrack || n.msDoNotTrack;
  var off = false;
  try { off = w.localStorage.getItem("trout-truck:ads-opt-out") === "1"; } catch (e) {}
  if (n.globalPrivacyControl === true || dnt === "1" || dnt === "yes" || off || !unit) { drop(); return; }
  function check() {
    if (done) return;
    var status = unit.getAttribute("data-ad-status");
    if (status === "filled") {
      done = true;
      box.classList.remove("ad-pending");
      box.removeAttribute("aria-hidden");
      if (label) label.hidden = false;
    }
    else if (status) drop();
  }
  if (w.MutationObserver) {
    new w.MutationObserver(check).observe(unit, { attributes: true, attributeFilter: ["data-ad-status"] });
  }
  w.setTimeout(function () { check(); if (!done) drop(); }, 10000);
  w.adsbygoogle = w.adsbygoogle || [];
  w.adsbygoogle.requestNonPersonalizedAds = 1;
  var s = d.createElement("script");
  s.async = true;
  s.crossOrigin = "anonymous";
  s.src = {{ ad.script_url|tojson }};
  s.onerror = drop;
  d.head.appendChild(s);
  try { w.adsbygoogle.push({}); } catch (e) { drop(); }
})();
</script>

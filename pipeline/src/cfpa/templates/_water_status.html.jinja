{# Status block at the top of a water page. Needs: water, water_status,
   source_fetched_label, canonical_url, app_store_url, root.
   Every date is a recorded week from CDFW's schedule; nothing is estimated.
   This week and next are never over, and CDFW posts most of a week's waters
   after it begins, so a missing entry there says "yet" and when we checked. #}
{% from "_status_badge.html.jinja" import status_badge %}
<section class="water-status" aria-labelledby="water-status-heading">
  <h2 id="water-status-heading">Where {{ water.name }} stands on CDFW's schedule</h2>
  <p>{{ status_badge(water_status.badge) }}</p>
  {#- The answer people come for, in one sentence, before the details
      (DECISIONS 0054). A week the record does not have is said in words. -#}
  <p class="water-answer">
    {%- if water_status.in_this_week -%}
    <strong>On CDFW's schedule this week, the week of {{ water_status.this_week }}{% if water_status.next_listed %}, and again the week of {{ water_status.next_listed }}{% endif %}.</strong>
    {%- elif water_status.next_listed -%}
    <strong>Next on CDFW's schedule: the week of {{ water_status.next_listed }}.</strong>{% if water_status.last_week %} Before that, it was last on the schedule the week of {{ water_status.last_week }}.{% endif %}
    {%- elif water_status.last_week -%}
    <strong>Not on CDFW's schedule for this week or later yet, as of {{ source_fetched_label }}.</strong> It was last on the schedule the week of {{ water_status.last_week }}, {{ water_status.days_ago_text }} before that check.
    {%- else -%}
    <strong>Not on CDFW's schedule in the weeks we have recorded since {{ water_status.since_text }}.</strong>
    {%- endif -%}
  </p>
  <p class="water-subscribe">
    {#- Right under the status block, inside the first phone screen
        (DECISIONS 0054); it sat below the lede and the county lists. Needs
        canonical_url, app_store_url and root.
        webcal:// makes a phone or desktop calendar subscribe and keep polling
        the feed; an https .ics link only imports today's copy. -#}
    {% set webcal_url = "webcal://" ~ canonical_url.split("://", 1)[1] ~ "feed.ics" %}
    <a href="{{ webcal_url }}" data-ga-event="calendar_subscribe_click" data-ga-placement="water" data-ga-type="webcal"><strong>Subscribe to {{ water.name }}'s planting calendar</strong></a>
    (your calendar app keeps it up to date) or
    <a href="feed.ics" data-ga-event="calendar_subscribe_click" data-ga-placement="water" data-ga-type="ics">download a one-time copy (.ics)</a>, which does not update
    {% if app_store_url %}
    &middot; <a href="{{ app_store_url }}" data-app-store-placement="water" data-app-store-kind="link">get the iOS app</a> for a notification when {{ water.name }} appears in a new week.
    {% else %}
    &middot; an iOS app with a notification when {{ water.name }} appears in a new week is on its way (<a href="{{ root }}about/#app">how it will work</a>).
    {% endif %}
  </p>
  <dl>
    <dt>Last on the schedule</dt>
    <dd>{{ water_status.last_sentence }}</dd>
    <dt>This week, the week of {{ water_status.this_week }}</dt>
    <dd>{{ "On CDFW's schedule." if water_status.in_this_week else "Not on CDFW's schedule yet, as of " ~ source_fetched_label ~ "." }}</dd>
    <dt>Next week, the week of {{ water_status.next_week }}</dt>
    <dd>{{ "On CDFW's schedule." if water_status.in_next_week else "Not on CDFW's schedule yet, as of " ~ source_fetched_label ~ "." }}</dd>
    {% if water_status.later_week %}
    <dt>Later on the schedule</dt>
    <dd>The week of {{ water_status.later_week }}.</dd>
    {% endif %}
    <dt>Weeks on the schedule</dt>
    <dd>On the schedule in {{ water_status.weeks_on_schedule }} {{ "week" if water_status.weeks_on_schedule == 1 else "weeks" }}, counting the weeks we have recorded since {{ water_status.since_text }}.</dd>
  </dl>
</section>

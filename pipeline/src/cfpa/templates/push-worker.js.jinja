/* The web push service worker (DECISIONS 0069), served at the site root as
   push-worker.js so its scope covers every water page. Rendered once per
   build with the push service's address and the VAPID public key, both of
   which are public by design.

   It does two things: shows the message the service sent (every push shows a
   notification, as the Push API requires), and opens the water page when the
   notification is tapped. The link in a message is treated as untrusted and
   must be on this site; anything else opens the site's root instead. A
   browser that rotates its subscription (pushsubscriptionchange) renews it
   with the service under the water the old one was for. Nothing else: no
   fetch handler, no cache, no page is ever served from here. */
/* global self, clients */
var API = {{ api_url|tojson }};
// Named so publish.yml's `gitleaks dir site` does not read this public value
// as a credential: its generic rule fires on "key" or "api" (so "vapid" too)
// next to a long string.
var SERVER_PUBLIC = {{ vapid_public_key|tojson }};

function toKey(base64url) {
  var padding = "=".repeat((4 - (base64url.length % 4)) % 4);
  var raw = atob((base64url + padding).replace(/-/g, "+").replace(/_/g, "/"));
  var out = new Uint8Array(raw.length);
  for (var i = 0; i < raw.length; i++) out[i] = raw.charCodeAt(i);
  return out;
}

function readPayload(event) {
  if (!event.data) return {};
  try {
    var parsed = event.data.json();
    return parsed && typeof parsed === "object" ? parsed : {};
  } catch (e) {
    return {};
  }
}

function safeUrl(value) {
  var root = new URL(self.registration.scope).href;
  try {
    var url = new URL(typeof value === "string" ? value : root, root);
    if (url.origin === self.location.origin && url.href.indexOf(root) === 0) return url.href;
  } catch (e) {
    // fall through
  }
  return root;
}

self.addEventListener("install", function () {
  self.skipWaiting();
});

self.addEventListener("activate", function (event) {
  event.waitUntil(clients.claim());
});

self.addEventListener("push", function (event) {
  var p = readPayload(event);
  var title = typeof p.title === "string" && p.title ? p.title : "Trout Truck";
  var options = {
    body: typeof p.body === "string" ? p.body : "",
    data: { url: safeUrl(p.url) }
  };
  if (typeof p.tag === "string" && p.tag) options.tag = p.tag;
  event.waitUntil(self.registration.showNotification(title, options));
});

self.addEventListener("notificationclick", function (event) {
  event.notification.close();
  var target = safeUrl(event.notification.data && event.notification.data.url);
  event.waitUntil(
    clients.matchAll({ type: "window", includeUncontrolled: true }).then(function (windows) {
      for (var i = 0; i < windows.length; i++) {
        if (windows[i].url === target && "focus" in windows[i]) return windows[i].focus();
      }
      return clients.openWindow ? clients.openWindow(target) : undefined;
    })
  );
});

self.addEventListener("pushsubscriptionchange", function (event) {
  var old = event.oldSubscription;
  event.waitUntil(
    self.registration.pushManager
      .subscribe({ userVisibleOnly: true, applicationServerKey: toKey(SERVER_PUBLIC) })
      .then(function (sub) {
        var json = sub.toJSON();
        return fetch(API + "/subscribe", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            replaces: old ? old.endpoint : null,
            subscription: { endpoint: sub.endpoint, keys: json.keys }
          })
        });
      })
      .catch(function () {
        // The next visit to the water page shows the button again.
      })
  );
});
